// Prisma Schema — TNLL Explore
// Dikonversi dari 18 Laravel migrations
// Jalankan: npx prisma db push (untuk DB baru)
// atau: npx prisma db pull (introspect dari DB yang sudah ada)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS & ADMINS ──────────────────────────────────────────────────────────

model User {
  id                Int       @id @default(autoincrement())
  name              String
  username          String?   @unique
  email             String    @unique
  googleId          String?   @unique @map("google_id")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  password          String?
  passwordChangedAt DateTime? @map("password_changed_at")
  phone             String?
  address           String?   @db.Text
  idType            String?   @map("id_type")
  idNumber          String?   @map("id_number")
  avatar            String?
  status            String    @default("active")
  lastLoginAt       DateTime? @map("last_login_at")
  lastLoginIp       String?   @map("last_login_ip")
  lastSeenAt        DateTime? @map("last_seen_at")
  rememberToken     String?   @map("remember_token")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relations
  bookings            Booking[]
  feedbacks           Feedback[]
  wishlists           Wishlist[]
  contentWishlists    ContentWishlist[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  activityLogs        ActivityLog[]
  searchHistories     SearchHistory[]
  visitLogs           VisitorLog[]
  articleComments     ArticleComment[]
  articleLikes        ArticleLike[]
  articleFavorites    ArticleFavorite[]
  articleViews        ArticleView[]
  destinationComments DestinationComment[]
  floraComments       FloraComment[]
  faunaComments       FaunaComment[]
  galleryComments     GalleryComment[]
  galleryLikes        GalleryLike[]
  galleryWishlists    GalleryWishlist[]
  chatConversations   ChatConversation[]
  newsletterSubscribers NewsletterSubscriber[]
  couponUsages        CouponUsage[]
  commentLikes        CommentLike[]
  floraCommentLikes   FloraCommentLike[]
  faunaCommentLikes   FaunaCommentLike[]
  galleryCommentLikes GalleryCommentLike[]
  articleCommentLikes ArticleCommentLike[]
  blockedCommenter    BlockedCommenter?
  articles            Article[]

  @@map("users")
}

model Admin {
  id                    Int       @id @default(autoincrement())
  name                  String
  email                 String    @unique
  username              String    @unique
  emailVerifiedAt       DateTime? @map("email_verified_at")
  password              String
  passwordChangedAt     DateTime? @map("password_changed_at")
  twoFactorSecret       String?   @map("two_factor_secret")
  twoFactorEnabled      Boolean   @default(false) @map("two_factor_enabled")
  twoFactorConfirmedAt  DateTime? @map("two_factor_confirmed_at")
  role                  String    @default("admin")
  createdById           Int?      @map("created_by")
  createdBy             Admin?    @relation("AdminCreatedBy", fields: [createdById], references: [id])
  createdAdmins         Admin[]   @relation("AdminCreatedBy")
  isActive              Boolean   @default(true) @map("is_active")
  lastLoginAt           DateTime? @map("last_login_at")
  rememberToken         String?   @map("remember_token")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  roles               AdminRole[]
  activityLogs        ActivityLog[]
  articleComments     ArticleComment[]
  articleRevisions    ArticleRevision[]
  destinationComments DestinationComment[]
  floraComments       FloraComment[]
  faunaComments       FaunaComment[]
  galleryComments     GalleryComment[]
  chatConversations   ChatConversation[]
  feedbackReplies     FeedbackReply[]
  announcements       Announcement[]
  createdEvents       Event[]
  newsletterCampaigns NewsletterCampaign[]
  validatedTickets    Ticket[]
  blockedCommenters   BlockedCommenter[]

  @@map("admins")
}

// ─── ROLES & PERMISSIONS ─────────────────────────────────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  admins      AdminRole[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  group       String?
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model AdminRole {
  adminId Int @map("admin_id")
  roleId  Int @map("role_id")
  admin   Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@map("admin_role")
}

// ─── DESTINATIONS ─────────────────────────────────────────────────────────────

model DestinationCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  icon        String?
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  destinations Destination[]

  @@map("destination_categories")
}

model Destination {
  id                   Int      @id @default(autoincrement())
  name                 String
  categoryId           Int?     @map("category_id")
  category             DestinationCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slug                 String   @unique
  description          String?  @db.Text
  shortDescription     String?  @db.Text @map("short_description")
  address              String   @db.Text
  city                 String
  province             String   @default("Sulawesi Tengah")
  latitude             Decimal? @db.Decimal(10, 8)
  longitude            Decimal? @db.Decimal(11, 8)
  googleMapsEmbed      String?  @db.Text @map("google_maps_embed")
  operatingHours       String?  @db.Text @map("operating_hours")
  contactPhone         String?  @map("contact_phone")
  contactEmail         String?  @map("contact_email")
  facilities           Json?
  rules                Json?
  parkingFees          Json?    @map("parking_fees")
  metaTitle            String?  @map("meta_title")
  metaDescription      String?  @db.Text @map("meta_description")
  keywords             String?
  isFeatured           Boolean  @default(false) @map("is_featured")
  showOperatingHours   Boolean  @default(true) @map("show_operating_hours")
  showFacilitiesRules  Boolean  @default(true) @map("show_facilities_rules")
  showPrices           Boolean  @default(true) @map("show_prices")
  showParkingFees      Boolean  @default(true) @map("show_parking_fees")
  isActive             Boolean  @default(true) @map("is_active")
  rating               Decimal  @default(0) @db.Decimal(2, 1)
  reviewCount          Int      @default(0) @map("review_count")
  visitorCount         Int      @default(0) @map("visitor_count")
  viewsCount           Int      @default(0) @map("views_count")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  images    DestinationImage[]
  prices    DestinationPrice[]
  bookings  Booking[]
  comments  DestinationComment[]
  wishlists Wishlist[]
  feedbacks Feedback[]
  galleries Gallery[]

  @@index([isActive, isFeatured, rating])
  @@map("destinations")
}

model DestinationImage {
  id            Int      @id @default(autoincrement())
  destinationId Int      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  imagePath     String?  @map("image_path")
  altText       String?  @map("alt_text")
  isPrimary     Boolean  @default(false) @map("is_primary")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("destination_images")
}

model DestinationPrice {
  id            Int      @id @default(autoincrement())
  destinationId Int      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  category      String
  label         String
  description   String?  @db.Text
  price         Decimal  @db.Decimal(12, 2)
  weekendPrice  Decimal? @db.Decimal(12, 2) @map("weekend_price")
  minAge        Int?     @map("min_age")
  maxAge        Int?     @map("max_age")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  bookingItems BookingItem[]

  @@unique([destinationId, category])
  @@map("destination_prices")
}

// ─── BOOKINGS & PAYMENTS ──────────────────────────────────────────────────────

model Coupon {
  id                     Int       @id @default(autoincrement())
  code                   String    @unique
  name                   String
  description            String?   @db.Text
  discountType           String    @default("percentage") @map("discount_type")
  discountValue          Decimal   @db.Decimal(10, 2) @map("discount_value")
  minOrderAmount         Decimal?  @db.Decimal(12, 2) @map("min_order_amount")
  maxDiscount            Decimal?  @db.Decimal(12, 2) @map("max_discount")
  usageLimit             Int?      @map("usage_limit")
  usedCount              Int       @default(0) @map("used_count")
  perUserLimit           Int?      @map("per_user_limit")
  startDate              DateTime? @map("start_date")
  endDate                DateTime? @map("end_date")
  isActive               Boolean   @default(true) @map("is_active")
  applicableDestinations Json?     @map("applicable_destinations")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  bookings  Booking[]
  usages    CouponUsage[]

  @@map("coupons")
}

model Booking {
  id              Int       @id @default(autoincrement())
  orderNumber     String    @unique @map("order_number")
  userId          Int?      @map("user_id")
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  destinationId   Int       @map("destination_id")
  destination     Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  visitDate       DateTime  @map("visit_date") @db.Date
  visitTime       String?   @map("visit_time")
  leaderName      String    @map("leader_name")
  leaderNik       String?   @map("leader_nik")
  leaderPhone     String    @map("leader_phone")
  leaderEmail     String    @map("leader_email")
  leaderAddress   String?   @map("leader_address")
  totalVisitors   Int       @default(0) @map("total_visitors")
  totalAdults     Int       @default(0) @map("total_adults")
  totalChildren   Int       @default(0) @map("total_children")
  totalSeniors    Int       @default(0) @map("total_seniors")
  totalMotorcycles Int      @default(0) @map("total_motorcycles")
  totalCars       Int       @default(0) @map("total_cars")
  totalBuses      Int       @default(0) @map("total_buses")
  specialRequests String?   @db.Text @map("special_requests")
  subtotal        Decimal   @default(0) @db.Decimal(12, 2)
  serviceFee      Decimal   @default(0) @db.Decimal(12, 2) @map("service_fee")
  discount        Decimal   @default(0) @db.Decimal(12, 2)
  discountCode    String?   @map("discount_code")
  totalAmount     Decimal   @default(0) @db.Decimal(12, 2) @map("total_amount")
  status          String    @default("pending")
  couponId        Int?      @map("coupon_id")
  coupon          Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountAmount  Decimal?  @db.Decimal(12, 2) @map("discount_amount")
  cancelReason    String?   @db.Text @map("cancel_reason")
  confirmedAt     DateTime? @map("confirmed_at")
  usedAt          DateTime? @map("used_at")
  cancelledAt     DateTime? @map("cancelled_at")
  expiredAt       DateTime? @map("expired_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  items        BookingItem[]
  payment      Payment?
  ticket       Ticket?
  couponUsages CouponUsage[]

  @@index([visitDate, status])
  @@index([userId, status])
  @@map("bookings")
}

model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int      @map("coupon_id")
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId Int      @map("booking_id")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  usedAt    DateTime @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coupon_usages")
}

model BookingItem {
  id                 Int      @id @default(autoincrement())
  bookingId          Int      @map("booking_id")
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  destinationPriceId Int      @map("destination_price_id")
  destinationPrice   DestinationPrice @relation(fields: [destinationPriceId], references: [id], onDelete: Cascade)
  category           String
  label              String
  quantity           Int
  unitPrice          Decimal  @db.Decimal(12, 2) @map("unit_price")
  totalPrice         Decimal  @db.Decimal(12, 2) @map("total_price")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("booking_items")
}

model Payment {
  id                   Int       @id @default(autoincrement())
  bookingId            Int       @unique @map("booking_id")
  booking              Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionId        String?   @unique @map("transaction_id")
  orderId              String    @unique @map("order_id")
  snapToken            String?   @map("snap_token")
  paymentType          String?   @map("payment_type")
  paymentChannel       String?   @map("payment_channel")
  vaNumber             String?   @map("va_number")
  paymentCode          String?   @map("payment_code")
  qrCodeUrl            String?   @map("qr_code_url")
  grossAmount          Decimal   @db.Decimal(12, 2) @map("gross_amount")
  status               String    @default("pending")
  paidAt               DateTime? @map("paid_at")
  expiredAt            DateTime? @map("expired_at")
  snapResponse         Json?     @map("snap_response")
  notificationResponse Json?     @map("notification_response")
  midtransResponse     String?   @db.Text @map("midtrans_response")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("payments")
}

model Ticket {
  id                Int       @id @default(autoincrement())
  bookingId         Int       @unique @map("booking_id")
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketCode        String    @unique @map("ticket_code")
  qrCodePath        String?   @map("qr_code_path")
  qrData            String?   @db.Text @map("qr_data")
  validDate         DateTime  @map("valid_date") @db.Date
  totalPersons      Int       @default(1) @map("total_persons")
  status            String    @default("valid")
  usedAt            DateTime? @map("used_at")
  validatedById     Int?      @map("validated_by")
  validatedBy       Admin?    @relation(fields: [validatedById], references: [id], onDelete: SetNull)
  validationNotes   String?   @map("validation_notes")
  downloadCount     Int       @default(0) @map("download_count")
  lastDownloadedAt  DateTime? @map("last_downloaded_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([validDate, status])
  @@map("tickets")
}

// ─── FEEDBACK & WISHLIST ──────────────────────────────────────────────────────

model Feedback {
  id             Int       @id @default(autoincrement())
  userId         Int?      @map("user_id")
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  destinationId  Int?      @map("destination_id")
  destination    Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  displayName    String?   @map("display_name")
  isAnonymous    Boolean   @default(false) @map("is_anonymous")
  subject        String
  message        String    @db.Text
  contactWhatsapp String?  @map("contact_whatsapp")
  contactEmail   String?   @map("contact_email")
  rating         Int?
  images         Json?
  status         String    @default("unread")
  isPublished    Boolean   @default(true) @map("is_published")
  ipAddress      String?   @map("ip_address")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  replies FeedbackReply[]

  @@map("feedbacks")
}

model FeedbackReply {
  id           Int      @id @default(autoincrement())
  feedbackId   Int      @map("feedback_id")
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  adminId      Int      @map("admin_id")
  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  replyMessage String   @db.Text @map("reply_message")
  isPublic     Boolean  @default(true) @map("is_public")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("feedback_replies")
}

model Wishlist {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId Int      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, destinationId])
  @@map("wishlists")
}

model ContentWishlist {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType String   @map("content_type")
  contentId   BigInt   @map("content_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, contentType, contentId])
  @@map("content_wishlists")
}

// ─── ANNOUNCEMENTS, BANNERS & EVENTS ─────────────────────────────────────────

model Announcement {
  id              Int       @id @default(autoincrement())
  title           String
  message         String    @db.Text
  type            String    @default("banner")
  notificationType String   @default("info") @map("notification_type")
  bgColor         String    @default("#059669") @map("bg_color")
  textColor       String    @default("#ffffff") @map("text_color")
  linkUrl         String?   @map("link_url")
  linkText        String?   @map("link_text")
  isDismissible   Boolean   @default(true) @map("is_dismissible")
  isActive        Boolean   @default(false) @map("is_active")
  priority        Int       @default(0)
  startAt         DateTime? @map("start_at")
  endAt           DateTime? @map("end_at")
  createdById     Int?      @map("created_by")
  createdBy       Admin?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  viewCount       Int       @default(0) @map("view_count")
  clickCount      Int       @default(0) @map("click_count")
  dismissCount    Int       @default(0) @map("dismiss_count")
  targetAudience  String    @default("all") @map("target_audience")
  targetPages     Json?     @map("target_pages")
  excludePages    Json?     @map("exclude_pages")
  position        String    @default("top")
  showDays        Json?     @map("show_days")
  showTimeStart   String?   @map("show_time_start")
  showTimeEnd     String?   @map("show_time_end")
  animationType   String    @default("fade") @map("animation_type")
  imagePath       String?   @map("image_path")
  showCountdown   Boolean   @default(false) @map("show_countdown")
  countdownLabel  String?   @map("countdown_label")
  extraButtons    Json?     @map("extra_buttons")
  historyLog      String?   @db.Text @map("history_log")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("announcements")
}

model Banner {
  id              Int       @id @default(autoincrement())
  title           String
  subtitle        String?
  imagePath       String    @map("image_path")
  mobileImagePath String?   @map("mobile_image_path")
  linkUrl         String?   @map("link_url")
  linkTarget      String    @default("_self") @map("link_target")
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  startAt         DateTime? @map("start_at")
  endAt           DateTime? @map("end_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("banners")
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  description String?   @db.Text
  content     String?   @db.Text
  image       String?
  location    String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  capacity    Int?
  price       Decimal   @default(0) @db.Decimal(12, 0)
  status      String    @default("draft")
  category    String    @default("other")
  createdById Int       @map("created_by")
  createdBy   Admin     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("events")
}

// ─── ARTICLES (BLOG) ─────────────────────────────────────────────────────────

model Article {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  excerpt         String?   @db.Text
  content         String    @db.Text
  revisionCount   Int       @default(0) @map("revision_count")
  lastAutoSave    DateTime? @map("last_auto_save")
  featuredImage   String?   @map("featured_image")
  category        String    @default("wisata")
  locale          String    @default("id")
  translationOfId Int?      @map("translation_of")
  translationOf   Article?  @relation("ArticleTranslations", fields: [translationOfId], references: [id], onDelete: SetNull)
  translations    Article[] @relation("ArticleTranslations")
  authorName      String?   @map("author_name")
  userId          Int?      @map("user_id")
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  isPublished     Boolean   @default(false) @map("is_published")
  isFeatured      Boolean   @default(false) @map("is_featured")
  isPinned        Boolean   @default(false) @map("is_pinned")
  publishedAt     DateTime? @map("published_at")
  scheduledAt     DateTime? @map("scheduled_at")
  archivedAt      DateTime? @map("archived_at")
  viewsCount      Int       @default(0) @map("views_count")
  likesCount      BigInt    @default(0) @map("likes_count")
  readingTime     Int       @default(0) @map("reading_time")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @db.Text @map("meta_description")
  metaKeywords    String?   @map("meta_keywords")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tags      ArticleTag[]    @relation("ArticleTagPivot")
  comments  ArticleComment[]
  likes     ArticleLike[]
  favorites ArticleFavorite[]
  views     ArticleView[]
  revisions ArticleRevision[]

  @@map("articles")
}

model Tag {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  articlesCount Int      @default(0) @map("articles_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  articles ArticleTag[] @relation("ArticleTagPivot")

  @@map("article_tags")
